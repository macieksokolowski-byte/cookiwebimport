# Konfiguracja CookiWebImport (Thermomix Cookidoo Importer)

# Metoda 1: Ciasteczko sesji _oauth2_proxy (ZALECANA, 100% odporna na 2FA / CAPTCHA)
# Pobierzesz je wchodząc na cookidoo.pl -> F12 -> Application -> Cookies -> _oauth2_proxy
COOKIDOO_JWT=

# Metoda 2: Bezpośrednie logowanie E-mail i Hasło
COOKIDOO_EMAIL=
COOKIDOO_PASSWORD=

# Kraj i język
COOKIDOO_COUNTRY=pl
COOKIDOO_LANGUAGE=pl

# Port aplikacji lokalnej
PORT=3000
